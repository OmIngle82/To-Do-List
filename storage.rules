rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if a user is authorized on a conversation.
    // Improved to safely handle cases where the conversation document does not exist.
    function isAuthorizedForConversation(conversationId) {
      let conversationPath = /databases/$(database)/documents/task_conversations/$(conversationId);
      return exists(conversationPath) && request.auth.uid in get(conversationPath).data.authorizedUsers;
    }

    // Profile photos can be read by anyone, but only written by the owner
    match /profile_photos/{userId}/{fileName} {
      allow read;
      allow write: if request.auth.uid == userId;
    }

    // Rules for NEW shared task attachments
    match /task_attachments/shared/{conversationId}/{fileName} {
      allow read, write: if request.auth.uid != null && isAuthorizedForConversation(conversationId)
                          // Granular size validation (10MB limit)
                          && request.resource.size < 10 * 1024 * 1024
                          // Enhanced content type matching for broader compatibility
                          && request.resource.contentType.matches('image/.*|video/.*|application/pdf|application/zip|application/msword|text/plain|application/vnd.ms-excel|application/vnd.ms-powerpoint|application/vnd.openxmlformats-officedocument.*');
    }

    // Rules for LEGACY task attachments (serves as a robust fallback)
    match /task_attachments/{userId}/{taskId}/{fileName} {
      allow write: if request.auth.uid == userId
                      // Granular size validation (10MB limit)
                      && request.resource.size < 10 * 1024 * 1024
                      // Enhanced content type matching for broader compatibility
                      && request.resource.contentType.matches('image/.*|video/.*|application/pdf|application/zip|application/msword|text/plain|application/vnd.ms-excel|application/vnd.ms-powerpoint|application/vnd.openxmlformats-officedocument.*');
      allow read: if request.auth.uid == userId;
    }
    
    // Temporary debug rules to help diagnose permission issues
    match /debug_uploads/{userId}/{fileName} {
        allow read, write: if request.auth.uid == userId;
    }

  }
}