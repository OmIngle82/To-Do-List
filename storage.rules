rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    // --- Helper Functions ---

    function isAuthorizedForConversation(conversationId) {
      let conversationPath = /databases/$(database)/documents/task_conversations/$(conversationId);
      return exists(conversationPath) && request.auth.uid in get(conversationPath).data.authorizedUsers;
    }

    function getUserData(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return exists(userPath) ? get(userPath).data : {};
    }

    // NEW helper function to check premium status
    function isPremiumUser(userId) {
      let userData = getUserData(userId);
      return userData.subscription != null && userData.subscription.status == 'premium';
    }

    // NEW helper for the premium-only shared attachments
    function checkPremiumStorageLimit(userId, newFileSize) {
      let userData = getUserData(userId);
      let MONTHLY_STORAGE_LIMIT = 1 * 1024 * 1024 * 1024; // 1GB
      let YEARLY_STORAGE_LIMIT = 10 * 1024 * 1024 * 1024; // 10GB
      let planId = userData.subscription != null ? userData.subscription.planId : null;
      let limit = planId == "plan_RZGREjjDG6aftY" ? YEARLY_STORAGE_LIMIT : MONTHLY_STORAGE_LIMIT;
      let currentUsage = userData.storageUsed != null ? userData.storageUsed : 0;
      
      // Return the boolean result of the check
      return (currentUsage + newFileSize < limit);
    }
    
    // NEW helper for the legacy attachments (which includes a free tier)
    function checkLegacyStorageLimit(userId, newFileSize) {
      let userData = getUserData(userId);
      let isPremium = userData.subscription != null && userData.subscription.status == 'premium';
      let planId = userData.subscription != null ? userData.subscription.planId : null;
      let FREE_STORAGE_LIMIT = 100 * 1024 * 1024; // 100MB
      let MONTHLY_STORAGE_LIMIT = 1 * 1024 * 1024 * 1024; // 1GB
      let YEARLY_STORAGE_LIMIT = 10 * 1024 * 1024 * 1024; // 10GB
      let limit = isPremium ? (planId == "plan_RZGREjjDG6aftY" ? YEARLY_STORAGE_LIMIT : MONTHLY_STORAGE_LIMIT) : FREE_STORAGE_LIMIT;
      let currentUsage = userData.storageUsed != null ? userData.storageUsed : 0;
      
      // Return the boolean result of the check
      return (currentUsage + newFileSize < limit);
    }

    // --- Rules ---

    // Profile photos can be read by anyone, but only written by the owner
    match /profile_photos/{userId}/{fileName} {
      allow read;
      allow write: if request.auth.uid == userId;
    }

    // Rules for NEW shared task attachments
    match /task_attachments/shared/{conversationId}/{fileName} {
      allow read: if request.auth.uid != null && isAuthorizedForConversation(conversationId);
      
      // The logic is now clean and readable using our new functions
      allow write: if request.auth.uid != null
                  && isAuthorizedForConversation(conversationId)
                  && isPremiumUser(request.auth.uid)
                  && request.resource.size < 10 * 1024 * 1024 // Individual file size check
                  && request.resource.contentType.matches('image/.*|video/.*|application/pdf|application/zip|application/msword|text/plain|application/vnd.ms-excel|application/vnd.ms-powerpoint|application/vnd.openxmlformats-officedocument.*');
    }

    // Rules for LEGACY task attachments (serves as a robust fallback)
    match /task_attachments/{userId}/{taskId}/{fileName} {
       allow read: if request.auth.uid == userId;
       
       // The logic is now clean and readable using our new function
       allow write: if request.auth.uid == userId
                   && checkLegacyStorageLimit(request.auth.uid, request.resource.size)
                   && request.resource.size < 10 * 1024 * 1024 // Individual file size check
                   && request.resource.contentType.matches('image/.*|video/.*|application/pdf|application/zip|application/msword|text/plain|application/vnd.ms-excel|application/vnd.ms-powerpoint|application/vnd.openxmlformats-officedocument.*');
    }

    // Temporary debug rules to help diagnose permission issues
    match /debug_uploads/{userId}/{fileName} {
        allow read, write: if request.auth.uid == userId;
    }

  }
}