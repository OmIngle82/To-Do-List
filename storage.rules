rules_version = '2';

service firebase.storage {
match /b/{bucket}/o {

// Profile photos can be read by anyone, but only written by the owner
match /profile_photos/{userId}/{fileName} {
  allow read;
  allow write: if request.auth.uid == userId;
}

// Rules for task attachments
match /task_attachments/{userId}/{taskId}/{fileName} {
  // Allow write if the user is the owner, and the file meets validation criteria.
  allow write: if request.auth.uid == userId
                  && request.resource.size < 10 * 1024 * 1024 // Max 10MB
                  && request.resource.contentType.matches('image/.*|application/pdf|application/msword|text/plain|application/vnd.ms-excel|application/vnd.ms-powerpoint|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet|application/vnd.openxmlformats-officedocument.presentationml.presentation');
  
  // Allow read only by the user who owns the task folder (the owner).
  // This is more secure. Access for shared tasks must be handled via download URLs.
  allow read: if request.auth.uid == userId;
}

}
}