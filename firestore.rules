rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- USER & TASK RULES ---
    match /users/{userId} {
      // Allows any signed-in user to 'get' any user's profile.
      allow get, list: if request.auth.uid != null;
      // A user can only create or update their own profile.
      allow create, update: if request.auth.uid == userId;

      match /tasks/{taskId} {
        allow read, write: if request.auth.uid == userId;
        // Rules for sharing/assigning tasks
        allow create: if request.auth.uid != null &&
                      request.auth.uid != userId &&
                      // NEW: Check if the person SENDING the task is a premium user
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscription.status == 'premium' &&
                      (request.resource.data.sharedBy.uid == request.auth.uid ||
                      request.resource.data.assignedBy.uid == request.auth.uid);
        allow update: if request.auth.uid != null &&
                      request.auth.uid != userId &&
                      request.auth.uid == resource.data.assignedTo.uid && // User is the assignee
                      resource.data.assignedTo.status == 'pending' && // Old status must be 'pending'
                      request.resource.data.assignedTo.status == 'completed' && // New status must be 'completed'
                      request.resource.data.assignedTo.completedAt != null && // A 'completed' timestamp must be set
                      // Check that nothing else on the task was changed
                      request.resource.data.text == resource.data.text &&
                      request.resource.data.priority == resource.data.priority &&
                      request.resource.data.category == resource.data.category;
      }
    }

    // --- RULES FOR TASK CONVERSATIONS & COMMENTS ---
    match /task_conversations/{conversationId} {
      allow create: if request.auth.uid in request.resource.data.authorizedUsers;
      allow read, update: if request.auth.uid in resource.data.authorizedUsers;
      
      match /comments/{commentId} {
        allow list, get: if request.auth.uid in get(/databases/$(database)/documents/task_conversations/$(conversationId)).data.authorizedUsers;
        allow create: if request.auth.uid in get(/databases/$(database)/documents/task_conversations/$(conversationId)).data.authorizedUsers &&
                       request.resource.data.authorId == request.auth.uid;
      }

      match /updates/{updateId} {
        allow read: if request.auth.uid in get(/databases/$(database)/documents/task_conversations/$(conversationId)).data.authorizedUsers;
        allow create: if request.auth.uid in get(/databases/$(database)/documents/task_conversations/$(conversationId)).data.authorizedUsers
                       && request.resource.data.updatedBy.uid == request.auth.uid;
        allow update, delete: if request.auth.uid == resource.data.updatedBy.uid;
      }
    }

    // --- SLACK INTEGRATION RULES ---
    match /slackIntegrations/{slackId} {
      // Allow a logged-in user to create a document linking their own account.
      allow write: if request.auth.uid != null &&
                    request.resource.data.firestoreUserId == request.auth.uid &&
                    // NEW: Check if the user linking their account is premium
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscription.status == 'premium';
    }
    match /system_analytics/{docId} {
      allow read: if request.auth.token.role == 'admin';
      allow write: if false;
    }
  }
}